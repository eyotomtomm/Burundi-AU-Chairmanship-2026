<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. This file lives in src/debug/res, so it replaces the
    production config in src/main/res for the debug variant and never ships in
    a release APK — release keeps cleartext blocked and the pins in place.

    Reason it exists: a debug build points at http://10.0.2.2:8000/api (the
    emulator's route to the host machine), and the production config blocks all
    cleartext, so every request failed before the app could show anything.
-->
<network-security-config>
    <!-- The local Django server, over plain HTTP. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- The live API stays HTTPS-only even in debug. Pins are deliberately
         absent here so a debugging proxy can terminate TLS locally. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">burundi4africa.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
