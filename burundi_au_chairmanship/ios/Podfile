# Define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Xcode 26 turns -Wquoted-include-in-framework-header into an error, and
  # several pods (GoogleDataTransport, PromisesObjC, TOCropViewController)
  # ship umbrella headers that trip it. The per-target loop below sets this
  # too, but the Pods *project-level* configs are regenerated by pod install
  # and default to YES, so they have to be cleared here as well.
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Set minimum deployment target to iOS 15.0
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
      # Fix module verification errors with Xcode 16+
      config.build_settings['OTHER_SWIFT_FLAGS'] ||= ['$(inherited)']
      config.build_settings['DEFINES_MODULE'] = 'YES'
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
    end

    # Disable strict module verification for Xcode 26 compatibility
    target.build_configurations.each do |config|
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['CLANG_VERIFY_MODULES'] = 'NO'
      config.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGES'] = ''
      config.build_settings['MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS'] = ''
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      # Xcode 26 promotes this warning to an error, which breaks the Firebase
      # AppCheck interop pods (they use double-quoted includes in framework headers).
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      # The build setting above is not reaching the umbrella-header compile
      # under Xcode 26, so silence the diagnostic at the compiler directly.
      cflags = config.build_settings['OTHER_CFLAGS'] || ['$(inherited)']
      cflags = [cflags] if cflags.is_a?(String)
      unless cflags.include?('-Wno-quoted-include-in-framework-header')
        cflags += ['-Wno-quoted-include-in-framework-header']
      end
      config.build_settings['OTHER_CFLAGS'] = cflags
    end

    # Fix GoogleSignIn/GTMAppAuth Swift-ObjC interop for Xcode 26
    if ['GoogleSignIn', 'GTMAppAuth', 'GTMSessionFetcher', 'AppAuth'].include?(target.name)
      target.build_configurations.each do |config|
        config.build_settings['SWIFT_VERSION'] = '5.0'
        config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
        config.build_settings['OTHER_CFLAGS'] ||= ['$(inherited)']
        config.build_settings['OTHER_CFLAGS'] << '-Wno-error=non-modular-include-in-framework-module'
      end
    end
  end
end
